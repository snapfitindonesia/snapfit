// Prisma schema — lihat docs/03-database.md.
// Dev: SQLite. Produksi: Postgres/Supabase (ganti cukup di datasource).
// Aturan: harga selalu integer (rupiah); gambar hanya URL (file fisik di CDN);
// enum & array Postgres TIDAK dipakai (biar portabel ke SQLite) — pakai String + relasi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (runtime) — Supabase :6543
  directUrl = env("DIRECT_URL")   // direct (migrate) — Supabase :5432
}

model Product {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  coverImage  String // URL cover (level produk)
  images      Json? // galeri foto fitur produk (array URL) — ditampilkan di PDP
  variantGroups Json? // nama & opsi variasi custom: { groups: [{name, options:[{value,desc}]}] }
  isGrosir    Boolean    @default(false) // true = tampil di halaman /grosir
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  discounts   Discount[] @relation("DiscountProducts") // ganti productIds[] → relasi m-n
  createdAt   DateTime   @default(now())
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // mis. "Hitam / iPhone 16 Pro" (display)
  color     String  @default("") // dimensi 1: warna (mis. "Hitam")
  type      String  @default("") // dimensi 2: tipe HP (mis. "iPhone 16 Pro")
  sku       String  @unique
  price     Int // rupiah, integer
  stock     Int     @default(0)
  image     String // 1 foto per varian
  weight    Int     @default(200) // berat gram — utk ongkir Biteship (lihat docs/05)
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  // Pohon kategori: brand (tingkat 1) → line/tipe HP (tingkat 2). parentId null = brand.
  parentId String?
  parent   Category?  @relation("CatTree", fields: [parentId], references: [id])
  children Category[] @relation("CatTree")
  order    Int        @default(0) // urutan tampil
  products Product[]
}

model Banner {
  id        String  @id @default(cuid())
  type      String // MAIN | ETALASE | PROMO
  image     String
  targetUrl String?
  order     Int     @default(0)
  active    Boolean @default(true)
}

model Discount {
  id       String    @id @default(cuid())
  name     String
  percent  Int // persen diskon
  products Product[] @relation("DiscountProducts") // produk yang kena diskon
  active   Boolean   @default(true)
  startAt  DateTime?
  endAt    DateTime?
}

model Voucher {
  id          String  @id @default(cuid())
  code        String  @unique
  type        String // POTONGAN | GRATIS_ONGKIR
  amount      Int     @default(0)
  minPurchase Int     @default(0)
  maxBenefit  Int     @default(0)
  active      Boolean @default(true)
}

model Order {
  id     String      @id @default(cuid())
  userId String? // id user Supabase Auth (tidak simpan password sendiri)
  status String      @default("PENDING") // PENDING|PAID|PROCESSING|SHIPPED|DONE|CANCELLED
  items  OrderItem[]

  subtotal     Int
  shippingCost Int
  discount     Int @default(0)
  total        Int

  // pembayaran
  midtransOrderId String? @unique
  paymentStatus   String?

  // pengiriman
  courier    String?
  trackingNo String?
  address    Json // snapshot alamat pengiriman
  shippedAt  DateTime? // diisi saat status → SHIPPED (basis timer ajakan ulas)

  // after-sales
  reviewRequestedAt DateTime? // diisi saat email ajakan ulas terkirim (anti-kirim ulang)

  createdAt DateTime @default(now())
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String // tanpa FK: snapshot, tahan walau varian dihapus
  name      String // snapshot nama saat beli
  price     Int // snapshot harga saat beli
  qty       Int
}
