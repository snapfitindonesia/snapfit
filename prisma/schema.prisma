// Prisma schema — lihat docs/03-database.md.
// Dev: SQLite. Produksi: Postgres/Supabase (ganti cukup di datasource).
// Aturan: harga selalu integer (rupiah); gambar hanya URL (file fisik di CDN);
// enum & array Postgres TIDAK dipakai (biar portabel ke SQLite) — pakai String + relasi.

generator client {
  provider   = "prisma-client-js"
  // Tanpa mesin query Rust (±17 MB/fungsi) → pakai driver pg (lib/db.ts). Fungsi Vercel jauh lebih
  // kecil: Functions Storage per deploy ±1,2 GB → jauh lebih kecil (batas Hobby 10 GB).
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (runtime) — Supabase :6543
  directUrl = env("DIRECT_URL")   // direct (migrate) — Supabase :5432
}

model Product {
  id          String     @id @default(cuid())
  slug        String     @unique // teks URL = dari judul TERBARU (lib/product-url.ts)
  shortId     Int? // ID angka TETAP di URL: /produk/<slug>-<shortId> (unik dijaga app: lib/product-url.ts nextShortId)
  legacySlug  String? // slug URL lama (sebelum format ID, Okt 2026) → dialihkan 301 ke URL baru
  name        String
  brand       String? // merek aksesori (mis. Ringke, Spigen, SNAPFIT) — tampil sbg badge di kartu
  description String?
  overview    String? // poin "Overview" di PDP, 1 baris = 1 poin; kosong = pakai default (SiteSetting pdp.overview)
  coverImage  String // URL cover (level produk)
  images      Json? // galeri foto fitur produk (array URL) — ditampilkan di PDP
  variantGroups Json? // nama & opsi variasi custom: { groups: [{name, options:[{value,desc}]}] }
  gineeProductId String? // id master produk Ginee (diisi saat impor) — utk sinkron stok
  isGrosir    Boolean    @default(false) // true = tampil di halaman /grosir
  featured    Boolean    @default(false) // true = tampil di "Produk Unggulan" homepage
  syncLocked  Boolean    @default(false) // true = stok/harga TIDAK ditimpa sinkron Ginee (kelola manual)
  archived    Boolean    @default(false) // true = disembunyikan dari toko/feed/sitemap (mis. produk sudah dihapus di Ginee)
  archivedBy  String? // "ginee" = diarsip otomatis sinkron (dipulihkan bila muncul lagi di Ginee); lainnya/null = manual (TIDAK dipulihkan sinkron)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  // Kategori tambahan (many-to-many) — 1 produk bisa masuk beberapa kategori,
  // mis. case yang muat Fold 7 & Fold 8. categoryId tetap kategori utama (breadcrumb).
  extraCategories Category[] @relation("ProductExtraCategories")
  variants    Variant[]
  reviews     Review[]
  createdAt   DateTime   @default(now())

  @@index([shortId])
  @@index([legacySlug])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String // nama pengulas
  image     String? // foto (opsional) — foto pembeli / foto produk dari pembeli
  rating    Int      @default(5) // 1-5 bintang
  comment   String
  createdAt DateTime @default(now())
  // Ulasan dari pembeli via /ulasan/[token] (lib/actions/review.ts). Ulasan buatan admin: default di bawah.
  approved  Boolean  @default(true) // false = menunggu moderasi admin (tak tampil di toko)
  verified  Boolean  @default(false) // true = dari pesanan nyata → badge "Pembeli terverifikasi"
  orderId   String? // pesanan asal ulasan pembeli
  photo     String? // foto produk dari pembeli (R2), tampil di bawah ulasan

  @@index([productId])
  @@index([orderId]) // 1 ulasan per produk per pesanan — dijaga di lib/actions/review.ts
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // mis. "Hitam / iPhone 16 Pro" (display)
  color     String  @default("") // dimensi 1: warna (mis. "Hitam")
  type      String  @default("") // dimensi 2: tipe HP (mis. "iPhone 16 Pro")
  sku       String? // opsional & bebas (boleh sama/kosong) — tak lagi wajib unik
  price     Int // rupiah, integer
  stock     Int     @default(0)
  image     String // 1 foto per varian
  weight    Int     @default(200) // berat gram — utk ongkir Biteship (lihat docs/05)
  discounts Discount[] @relation("DiscountVariants") // diskon per-varian
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  image    String? // foto utk mega menu (opsional)
  // Pohon kategori 3 tingkat: brand (1) → seri (2) → model (3). parentId null = brand.
  parentId String?
  parent   Category?  @relation("CatTree", fields: [parentId], references: [id])
  children Category[] @relation("CatTree")
  order    Int        @default(0) // urutan tampil
  products Product[]
  extraProducts Product[] @relation("ProductExtraCategories") // produk yang menandai kategori ini sbg tambahan
}

// Merek aksesori (SNAPFIT, Ringke, Araree, dst) — daftar terkelola untuk
// dropdown di form produk. Product.brand menyimpan NAMA merek terpilih.
model Merek {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)
}

model Banner {
  id        String  @id @default(cuid())
  type      String // MAIN | ETALASE | PROMO
  image     String
  targetUrl String?
  order     Int     @default(0)
  active    Boolean @default(true)
}

model Discount {
  id       String    @id @default(cuid())
  name     String
  percent  Int // persen diskon
  variants Variant[] @relation("DiscountVariants") // varian yang kena diskon
  active   Boolean   @default(true)
  startAt  DateTime?
  endAt    DateTime?
  campaign String? // payday-sale | tanggal-kembar → tampil di /promo/[slug] (lib/campaigns.ts)

  @@index([campaign])
}

model Voucher {
  id          String  @id @default(cuid())
  code        String  @unique
  type        String // POTONGAN | GRATIS_ONGKIR
  amount      Int     @default(0)
  minPurchase Int     @default(0)
  maxBenefit  Int     @default(0)
  active      Boolean @default(true)
  stackable   Boolean @default(false) // bisa digabung dgn voucher JENIS LAIN yang juga stackable
}

model Order {
  id     String      @id @default(cuid())
  userId String? // id user Supabase Auth (tidak simpan password sendiri)
  status String      @default("PENDING") // PENDING|PAID|PROCESSING|SHIPPED|DONE|CANCELLED
  items  OrderItem[]

  subtotal     Int
  shippingCost Int
  discount     Int     @default(0)
  voucherCodes String? // kode voucher terpakai, dipisah "+" (mis. "SNAP20K+GRATISONGKIR")
  coinsUsed    Int     @default(0) // koin member terpakai (1 koin = Rp1), sudah dikurangkan dari total
  cashbackPercent Float? // % cashback koin yang berlaku SAAT pesanan dibuat (termasuk promo berjadwal); null = tamu
  total        Int

  // pembayaran
  midtransOrderId String? @unique
  paymentStatus   String?

  // pengiriman
  courier    String?
  trackingNo String?
  address    Json // snapshot alamat pengiriman
  shippedAt  DateTime? // diisi saat status → SHIPPED (basis timer ajakan ulas)

  // pengingat bayar (transfer manual) — diisi saat email pengingat terkirim (anti-kirim ulang)
  paymentReminderAt DateTime?

  // after-sales
  reviewRequestedAt DateTime? // diisi saat email ajakan ulas terkirim (anti-kirim ulang)
  reviewToken       String? // token acak 128-bit tautan /ulasan/[token] (tanpa data pribadi di URL)

  // integrasi Ginee
  gineePushedAt DateTime? // diisi saat order berhasil dikirim ke Ginee (anti-kirim ulang)
  gineeOrderSn  String? // externalOrderSn yang dipakai saat push ke Ginee

  createdAt DateTime @default(now())

  @@index([reviewToken])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String // tanpa FK: snapshot, tahan walau varian dihapus
  name      String // snapshot nama saat beli
  price     Int // snapshot harga saat beli
  qty       Int
}

// Halaman link-in-bio (/links) — profil tunggal (id "main") + daftar tombol.
model BioProfile {
  id        String  @id @default("main")
  title     String  @default("SNAPFIT")
  bio       String?
  avatar    String?
  instagram String?
  tiktok    String?
  whatsapp  String? // nomor (62…) atau URL wa.me
  shopee    String?
  tokopedia String?
  youtube   String?
  facebook  String?
  // Latar: warna solid (bgColor), gradien (bgColor → bgColor2), atau gambar (bgImage).
  bgColor   String?
  bgColor2  String?
  bgImage   String?
  textLight Boolean @default(false) // teks judul/bio putih (untuk latar gelap)
}

model BioLink {
  id        String  @id @default(cuid())
  kind      String  @default("LINK") // LINK = tombol · DIVIDER = pemisah bagian (judul opsional, tanpa URL)
  title     String
  url       String
  image     String? // thumbnail kecil di kiri tombol (opsional)
  highlight Boolean @default(false) // tombol ditonjolkan (hitam)
  newTab    Boolean @default(false) // buka di tab baru
  order     Int     @default(0)
  active    Boolean @default(true)
  clicks    Int     @default(0)
}

model NavLink {
  id       String  @id @default(cuid())
  label    String
  url      String
  location String  @default("HEADER") // HEADER | FOOTER
  kind     String  @default("LINK") // LINK | MEGA (dropdown Kategori) — header saja
  order    Int     @default(0)
  newTab   Boolean @default(false)
  active   Boolean @default(true)
}

/// Checkout yang belum jadi pesanan — untuk pengingat keranjang ditinggal.
/// Disimpan saat pembeli mengisi kontak di /checkout (lib/actions/cart-draft.ts).
model CheckoutDraft {
  id          String    @id @default(cuid())
  clientId    String    @unique // id acak per browser (localStorage) → satu draf per perangkat
  token       String    @unique // token acak untuk tautan "pulihkan keranjang" (tanpa data pribadi di URL)
  name        String?
  email       String? // huruf kecil
  phone       String? // format 62…
  items       Json // [{ variantId, qty }]
  subtotal    Int       @default(0)
  remindedAt  DateTime? // email pengingat terkirim (sekali per draf)
  recoveredAt DateTime? // tautan pemulihan diklik
  convertedAt DateTime? // jadi pesanan
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
  @@index([email])
  @@index([phone])
}

/// Email yang meminta berhenti menerima pengingat keranjang.
model EmailOptOut {
  email     String   @id
  createdAt DateTime @default(now())
}

/// Kata kunci pencarian di /produk (teragregasi per kata kunci) — Admin → Pencarian.
/// Dicatat dari lib/actions/search-log.ts; hanya pencarian tanpa filter lain.
model SearchTerm {
  term        String   @id // huruf kecil, spasi dirapikan, maks 60 karakter
  count       Int      @default(0) // total dicari
  zeroCount   Int      @default(0) // berapa kali hasilnya 0
  lastResults Int      @default(0) // jumlah hasil pada pencarian terakhir
  lastAt      DateTime @default(now())

  @@index([lastAt])
}

/// Ongkir per provinsi tujuan (Admin → Penjualan → Ongkir). Provinsi tanpa baris →
/// tarif flat (SHIPPING_FLAT_COST). Dipakai saat SHIPPING_MODE=flat (lib/shipping-zone.ts).
model ShippingZone {
  provinceCode String   @id // kode Kemendagri, mis. "32" (Jawa Barat)
  provinceName String
  baseCost     Int // rupiah untuk 1 kg pertama
  perKg        Int      @default(0) // tambahan per kg berikutnya
  etd          String   @default("") // estimasi, mis. "2-3 hari"
  available    Boolean  @default(true) // false = belum ada kurir ke provinsi ini → checkout ditolak
  updatedAt    DateTime @updatedAt
}

// Pengaturan toko sederhana (key → JSON), mis. "pdp.overview" = ["poin 1", ...].
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Buku besar koin member (lib/coins.ts). Tiap perolehan = satu "lot" (amount > 0) dengan sisa
// `remaining` & kedaluwarsa sendiri; pemakaian mengurangi `remaining` lot paling cepat hangus
// (FIFO) + dicatat sebagai baris negatif. Saldo = jumlah `remaining` lot yang belum hangus.
// `ref` unik = idempoten (mis. "cashback:<orderId>") → koin tak pernah tercatat dobel.
model CoinEntry {
  id         String    @id @default(cuid())
  userId     String // id user Supabase Auth
  amount     Int // + perolehan, − pemakaian/hangus/koreksi
  kind       String // SIGNUP|CASHBACK|REVIEW|REFUND|ADJUST (+) · SPEND|EXPIRE|REVOKE|ADJUST (−)
  ref        String?   @unique
  note       String?
  remaining  Int       @default(0) // sisa lot yang belum terpakai (hanya baris +)
  expiresAt  DateTime? // kedaluwarsa lot (hanya baris +)
  notifiedAt DateTime? // email "koin segera hangus" sudah terkirim untuk lot ini
  orderId    String?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}
